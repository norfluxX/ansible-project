global:
  scrape_interval: 15s

scrape_configs:
  - job_name: node
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - '{{ hostvars[host].ansible_host }}:9100'
{% endfor %}

  - job_name: applications
    metrics_path: /health
    static_configs:
      - targets:
{% for host in groups['app'] %}
          - '{{ hostvars[host].ansible_host }}:8000'
          - '{{ hostvars[host].ansible_host }}:8001'
          - '{{ hostvars[host].ansible_host }}:8002'
{% endfor %}
